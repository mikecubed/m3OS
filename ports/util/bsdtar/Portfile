# Phase 105 Track E — bsdtar (libarchive), the workstation's archiver.
# Static bsdtar only (bsdcat/bsdcpio/bsdunzip disabled); zlib is the one
# compression backend (gzip + POSIX/GNU tar formats) — bz2/lzma/lz4/zstd
# have no in-tree ports and are disabled, as are every crypto/XML backend
# (openssl/mbedtls/nettle/xml2/expat) and acl/xattr (no such syscalls).
NAME=bsdtar
VERSION=3.8.8
DESCRIPTION="bsdtar archiver from libarchive (static, zlib-only)"
CATEGORY=util
DEPS=zlib
URL=https://github.com/libarchive/libarchive/releases/download/v3.8.8/libarchive-3.8.8.tar.gz
SHA256=038918ea315cdd446cc63acfe880d6011832bbe1711c887de5de5441b306c190
MAINTAINER=m3os
