NAME=curl
VERSION=8.15.0
DESCRIPTION="curl/libcurl — static HTTP/HTTPS client (mbedTLS backend) for git smart-HTTP"
CATEGORY=util
DEPS=zlib mbedtls
URL=https://curl.se/download/curl-8.15.0.tar.xz
SHA256=6cd0a8a5b126ddfda61c94dc2c3fc53481ba7a35461cf7c5ab66aa9d6775b609
MAINTAINER=m3os

# Phase 86c Track B — the static libcurl that git's smart-HTTP transport shells
# the bytes through. git does not implement TLS itself; its `git-remote-https`
# helper links libcurl, and libcurl carries the mbedTLS backend that validates
# GitHub's TLS 1.3 cert chain + hostname. So curl is a build-time dependency of
# the rebuilt HTTPS git: its `.m3pkg` carries the linked TLS code, and git's
# `DEPS` pulls it in (transitively pulling mbedtls + ca-certificates).
#
# DEPS encode the dependency-first build order zlib -> mbedtls -> curl (and git
# then adds curl + ca-certificates), so the Phase 85a topological solver resolves
# zlib -> mbedtls -> curl -> ca-certificates -> git.
#
# Build identity (see build_curl in xtask/src/port_build.rs):
#   --with-mbedtls                  — curl's documented small-footprint TLS backend
#                                     (curl 8.15 dropped BearSSL); links the staged
#                                     static mbedtls archives.
#   --with-ca-bundle=               — curl's compiled-in default CAINFO matches the
#     /etc/ssl/certs/ca-certificates.crt Phase 86a path that git also uses, so
#                                     trust does not silently break across the two.
#   --with-zlib                     — staged static zlib (HTTP content + transfer
#                                     decompression).
#   --disable-shared --enable-static -static — m3OS's ld-musl has no real libc.so,
#                                     so every port is a static binary.
#   HTTP/HTTPS only                 — every other protocol + feature
#                                     (ftp/ldap/imap/smtp/.../libpsl/libidn) is
#                                     disabled to keep the binary small; SNI +
#                                     SSL_VERIFYHOST=2 stay on for hostname verify.
#
# GitHub serves TLS 1.3 with an ECDSA P-256 leaf and offers
# TLS_CHACHA20_POLY1305_SHA256; with no hardware AES-NI until Phase 86f, the
# mbedTLS backend prefers ChaCha20-Poly1305 over soft AES-GCM.
