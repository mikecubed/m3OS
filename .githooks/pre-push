#!/usr/bin/env bash
# Pre-push hook: run full quality gates before pushing to remote.
#
# Requires bash (not POSIX sh): the gate steps pipe `cargo xtask ...` through
# `tee` so their output is both shown live and captured for the SKIP/PASS greps
# below, and we need the exit status of the *cargo* command, not `tee`. We read
# it via `${PIPESTATUS[0]}`, a bashism — under `#!/bin/sh` (dash) `PIPESTATUS`
# is unset and a bare `$?` would be tee's status, silently masking a failing
# smoke-test/test/regression run. (`pipefail` is deliberately *not* set: the
# flake-retry blocks below build lists from greps that legitimately match
# nothing, and `set -e` + `pipefail` would abort on those empty pipelines.)
#
# The PR CI gate only runs static checks (clippy/fmt/host tests/loom) because
# GitHub's 2-vCPU shared runners can't execute TCG-emulated QEMU workloads
# reliably under Phase 54's IPC-heavy VFS. Full-system tests run here on
# developer hardware instead (and in the nightly workflow for scheduled
# coverage).
#
# Skipping the QEMU gates is not supported. The M3OS_SKIP_QEMU_TESTS
# env-var escape was removed because it let pre-existing regressions ride
# along with otherwise-clean commits (see PR #116, Phase 55b driver
# crash-loop incident).
#
# If you hit a genuine infra blocker (e.g., QEMU missing on a migration
# laptop), install QEMU + OVMF before pushing. In a true emergency
# `git push --no-verify` still works, but it is an explicit, visible
# opt-out — not an env-var that silently persists.
#
# Regression-suite flake handling (2026-04-25): `cargo xtask regression`
# runs every test back-to-back inside a single QEMU process pool, and the
# resulting resource contention occasionally produces spurious timeouts.
# The suite step below catches that pattern: if the all-tests run reports
# failures, each failing test is re-run with `--test <name>`, which
# launches a fresh QEMU. The push is rejected only when a test fails both
# in the suite *and* on its own. See post-mortem
# docs/post-mortems/2026-04-24-ingress-task-starvation.md, Lessons.
#
# Kernel-tests gate added 2026-05-08 after the trace-ring stack-overflow
# bug (commit 92537db) rode this branch for two days because pre-push only
# ran smoke-test + regression — `cargo xtask test` exercises a different
# set of QEMU binaries (kernel-mode unit tests, preempt_voluntary,
# preempt_user_stress, xsave_avx, etc.) that neither smoke-test nor
# regression cover. Same retry-on-isolate flake pattern as regression.

set -e

# Locate cargo — try PATH first, then ~/.cargo/env
if ! command -v cargo >/dev/null 2>&1; then
    if [ -f "$HOME/.cargo/env" ]; then
        . "$HOME/.cargo/env"
    else
        echo "pre-push: cargo not found — install Rust toolchain before pushing" >&2
        exit 1
    fi
fi

echo "pre-push: running cargo xtask check..."
cargo xtask check

if ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
    echo "pre-push: qemu-system-x86_64 not found — install QEMU and OVMF" >&2
    echo "          to run the full-system smoke + regression gates." >&2
    exit 1
fi

# Allocate temp logs up front and install a single EXIT trap.  Each gate
# below writes into its own log; the trap cleans both whether the script
# exits cleanly or aborts.
test_log="$(mktemp)"
regression_log="$(mktemp)"
smoke_log="$(mktemp)"
trap 'rm -f "$test_log" "$regression_log" "$smoke_log"' EXIT

echo "pre-push: running cargo xtask smoke-test..."
# Capture the smoke output so the opt-in TLS/DNS gates below can assert the
# musl-built tls-smoke / dns-smoke stages actually PASSed rather than SKIPped
# (a SKIP means the musl toolchain was absent at build, which would otherwise
# let the Track C PT_TLS/pthread and Track D.1 DNS fixes ride unverified).
set +e
cargo xtask smoke-test --timeout 300 2>&1 | tee "$smoke_log"
smoke_status=${PIPESTATUS[0]}  # exit status of cargo, not tee
set -e
if [ "$smoke_status" -ne 0 ]; then
    echo "pre-push: cargo xtask smoke-test failed" >&2
    exit 1
fi

# Phase 77 — opt-in TLS regression gate. tls-smoke is a full-musl static binary
# whose only purpose is to exercise the Track C clone(CLONE_THREAD) r9-preserve
# + PT_TLS fix; when the musl cross-compiler is absent it is staged as a
# zero-byte placeholder and the smoke-runner emits SMOKE:tls-smoke:SKIP, so the
# headline fix is never run. Set M3OS_TLS_REGRESSION=1 on branches that touch
# the kernel clone path, make_fork_ctx_for_thread, the ELF PT_TLS loader, or the
# futex CHILD_CLEARTID wake to REQUIRE a real PASS (install a musl cross-gcc).
if [ "${M3OS_TLS_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: enforcing tls-smoke PASS (M3OS_TLS_REGRESSION=1)..."
    if grep -q 'SMOKE:tls-smoke:SKIP' "$smoke_log" || ! grep -q 'SMOKE:tls-smoke:PASS' "$smoke_log"; then
        echo "pre-push: tls-smoke did not PASS (SKIP or absent). Install a musl" >&2
        echo "          cross-compiler (e.g. x86_64-linux-musl-gcc) so the Track C" >&2
        echo "          PT_TLS / pthread fix is actually exercised." >&2
        exit 1
    fi
fi

# Phase 77 — opt-in DNS regression gate. dns-smoke is musl-built; SMOKE:dns-smoke:SKIP
# means the binary was absent (musl missing), whereas SMOKE:dns-smoke:PASS means the
# resolver path ran end to end (it accepts DNS_SMOKE:SKIP offline, so a real
# resolution cannot be required in a sandbox — but the path running without
# hanging can). Set M3OS_DNS_REGRESSION=1 on branches touching the resolver /
# recvmsg / ephemeral-UDP path to REQUIRE the path is exercised.
if [ "${M3OS_DNS_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: enforcing dns-smoke PASS (M3OS_DNS_REGRESSION=1)..."
    if grep -q 'SMOKE:dns-smoke:SKIP' "$smoke_log" || ! grep -q 'SMOKE:dns-smoke:PASS' "$smoke_log"; then
        echo "pre-push: dns-smoke did not PASS (SKIP or absent). Install a musl" >&2
        echo "          cross-compiler so the Track D.1 resolver path is exercised." >&2
        exit 1
    fi
fi

echo "pre-push: running cargo xtask test..."
# Same retry-on-isolate pattern as regression below.  The kernel-test
# suite runs each binary in its own QEMU instance but back-to-back in
# one xtask invocation; resource contention can produce spurious
# timeouts on the same documented harness-flake shape.  Re-run any
# failed binary in isolation; only fail the gate when it still fails
# on a fresh QEMU.
set +e
cargo xtask test --timeout 90 2>&1 | tee "$test_log"
test_status=${PIPESTATUS[0]}  # exit status of cargo, not tee
set -e
if [ "$test_status" -ne 0 ]; then
    # cargo xtask test prints `Test <name>-<hash>: FAILED ...` per failed
    # binary; strip the trailing `-<hex>` to get the cargo `--test` name.
    failed_tests="$(grep -E '^Test [a-z0-9_]+-[0-9a-f]+: FAILED' "$test_log" \
                    | sed -E 's/^Test ([a-z0-9_]+)-[0-9a-f]+: FAILED.*/\1/' \
                    | sort -u)"
    if [ -z "$failed_tests" ]; then
        echo "pre-push: cargo xtask test failed but no per-test FAILED lines parsed" >&2
        exit 1
    fi
    echo "pre-push: kernel-test failures detected — re-running flakes in isolation:"
    for t in $failed_tests; do echo "          - $t"; done
    real_failures=""
    for t in $failed_tests; do
        echo "pre-push: isolated re-run: $t"
        if ! cargo xtask test --test "$t" --timeout 90; then
            real_failures="$real_failures $t"
        fi
    done
    if [ -n "$real_failures" ]; then
        echo "pre-push: kernel-test failures persisted in isolation:$real_failures" >&2
        exit 1
    fi
    echo "pre-push: all kernel-test failures passed in isolation — treating as harness flakiness."
fi

echo "pre-push: running cargo xtask device-smoke --device nvme --iommu..."
cargo xtask device-smoke --device nvme --iommu --timeout 90

echo "pre-push: running cargo xtask device-smoke --device e1000 --iommu..."
cargo xtask device-smoke --device e1000 --iommu --timeout 90

# Phase 63 audio gate (2026-05-11): the audio path went deterministic
# (5/5 in the closing session) and the smoke now exercises Open / submit
# / drain / close twice, so a regression in the AC'97 BDL programming,
# audio_server takeover, or audio-demo Io(-32) retry surfaces here.
# Failure shape: missing AUDIO_DEMO:PASS sentinel, or the WAV non-silent
# check reporting <5% non-silent samples in any 1-second window.
echo "pre-push: running cargo xtask audio-smoke..."
cargo xtask audio-smoke --timeout 90

echo "pre-push: running cargo xtask regression..."
# Suite-level QEMU contention occasionally causes spurious timeouts on
# individual tests (see docs/post-mortems/2026-04-24-ingress-task-starvation.md
# "Lessons" — cargo xtask regression is not test-isolated). When the suite
# reports failures, re-run each failing test in isolation; only declare a
# real failure if it still fails on a fresh QEMU. This preserves the
# regression gate's authority over genuine regressions while keeping the
# pre-push hook stable against the documented harness flakiness.
# `set -e` would abort on the first failed cargo xtask invocation; disable
# it for the suite run so we can capture the per-test FAIL lines from the
# log and decide whether to retry them in isolation.
set +e
cargo xtask regression --timeout 90 2>&1 | tee "$regression_log"
suite_status=${PIPESTATUS[0]}  # exit status of cargo, not tee
set -e
if [ "$suite_status" -ne 0 ]; then
    failed_tests="$(grep -E '^  [a-z0-9_-]+: FAIL' "$regression_log" \
                    | sed -E 's/^  ([a-z0-9_-]+): FAIL.*/\1/')"
    if [ -z "$failed_tests" ]; then
        echo "pre-push: regression suite failed but no per-test FAIL lines parsed" >&2
        exit 1
    fi
    echo "pre-push: suite-level failures detected — re-running flakes in isolation:"
    for t in $failed_tests; do echo "          - $t"; done
    real_failures=""
    for t in $failed_tests; do
        echo "pre-push: isolated re-run: $t"
        if ! cargo xtask regression --test "$t" --timeout 90; then
            real_failures="$real_failures $t"
        fi
    done
    if [ -n "$real_failures" ]; then
        echo "pre-push: regression failures persisted in isolation:$real_failures" >&2
        exit 1
    fi
    echo "pre-push: all suite failures passed in isolation — treating as harness flakiness."
fi

if [ "${M3OS_E1000_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask ssh-e1000-banner-check..."
    cargo xtask ssh-e1000-banner-check --timeout 30
fi

# Phase 63a doom-audio gate. Gated behind M3OS_DOOM_AUDIO_REGRESSION=1
# because (a) DOOM rebuilds aren't free (16 MB+ of musl-static engine
# + Rust staticlibs) and (b) the gate runs `/bin/doom` for 8.5 in-game
# seconds inside QEMU which adds ~30s wall-clock. Set the env var on
# branches that touch userspace/doom, userspace/lib/audio_mixer,
# userspace/lib/audio_client_ffi, or audio_server's PCM path so the
# regression catches DOOM-side audio drift before merge.
if [ "${M3OS_DOOM_AUDIO_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask doom-audio-smoke..."
    cargo xtask doom-audio-smoke --timeout 120
fi

# Phase 70 Track F.2 — doom concurrent-instance regression. Gated
# behind M3OS_DOOM_CONCURRENT_REGRESSION=1 because the gate boots
# QEMU, launches two DOOMs simultaneously under display_server, and
# waits for both to complete the autoquit lifecycle — ~45s wall-clock.
# Set the env var on branches that touch userspace/doom,
# userspace/lib/display_client_ffi, userspace/display_server, or the
# Phase 56 protocol codec so the regression catches multi-client
# surface-buffer drift before merge.
if [ "${M3OS_DOOM_CONCURRENT_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask doom-concurrent-smoke..."
    cargo xtask doom-concurrent-smoke --timeout 120
fi

# Phase 69a Track I.2 — termios contract gate. Gated behind
# M3OS_TERMIOS_REGRESSION=1 because the gate boots QEMU + runs six
# /bin/tcsmoke subcommands; ~35s wall-clock.  Set the env var on
# branches that touch the kernel TTY/PTY ldisc, the termios ioctl
# branches, or syscall-lib's tcgetattr/tcsetattr surface.
if [ "${M3OS_TERMIOS_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask termios-smoke..."
    cargo xtask termios-smoke --timeout 90
fi

# Phase 69d Track E.1 — tui-app regression gate. Gated behind
# M3OS_TUI_APP_REGRESSION=1 because the gate cross-compiles ncurses +
# libevent + less + htop + tmux (cold-build budget ~5-7 min) before
# booting QEMU and driving 32 scripted steps. Set the env var on
# branches that touch the ports system, the kernel TTY/PTY layer,
# the term emulator, or any of the Phase 69-series terminal contract
# surfaces.
if [ "${M3OS_TUI_APP_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask tui-app-smoke..."
    cargo xtask tui-app-smoke --timeout 300
fi

# Phase 72 Track H.3 — tiling regression gate. Gated behind
# M3OS_TILING_REGRESSION=1 because the gate boots QEMU, exchanges
# ~10 m3ctl verbs, and asserts the workspace + tile-fullscreen + reload
# path end-to-end (~30-45s wall-clock). Set the env var on branches
# that touch userspace/display_server, userspace/lib/layout,
# userspace/m3ctl, or the Phase 72 control-socket codec.
if [ "${M3OS_TILING_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask tiling-smoke..."
    cargo xtask tiling-smoke --timeout 120
fi

# Phase 77 — htop process-list regression gate. Gated behind
# M3OS_HTOP_REGRESSION=1 because the gate cross-compiles the ncurses +
# htop ports and boots the graphical stack headlessly (QMP + VNC), then
# asserts htop renders a *populated* process table (not just that it
# launched). Set the env var on branches that touch kernel/src/fs/procfs.rs,
# the /proc syscall surface, or the scheduler's per-task accounting.
if [ "${M3OS_HTOP_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask htop-render-probe..."
    cargo xtask htop-render-probe --timeout 300
fi

# Phase 84 — Spectre mitigations reporter gate. Gated behind
# M3OS_MITIGATIONS_REGRESSION=1 because it boots the OS and asserts, at runtime,
# the boot mitigation-policy log (`[sec] mitigations=... global_kernel_ptes=0`)
# AND the `m3ctl mitigations status` reporter output (per-vuln Meltdown line +
# the compiled-in retpoline line + the UNADDRESSED enumeration). KPTI-independent
# (default boot). Set on branches touching kernel/src/mitigations.rs,
# kernel-core/src/spectre.rs, the SPEC_CTRL path in cpuid.rs, or m3ctl's
# mitigations subcommand.
if [ "${M3OS_MITIGATIONS_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask mitigations-status-smoke..."
    cargo xtask mitigations-status-smoke --timeout 150
fi

# Phase 78a — xHCI host-controller bring-up gate. Gated behind
# M3OS_USB_REGRESSION=1 because it boots QEMU with `-device qemu-xhci` and
# asserts the ring-3 xhci_driver reaches a first Enable Slot Command
# Completion delivered via MSI-X (not just a "ports detected" serial line).
# Set the env var on branches that touch userspace/drivers/xhci,
# kernel-core/src/usb, the device-host claim/IRQ syscalls
# (kernel/src/syscall/device_host.rs), or the PCI Bus-Master/MSI-X path.
if [ "${M3OS_USB_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask xhci-bringup-smoke..."
    cargo xtask xhci-bringup-smoke --timeout 150
    # Phase 78b — enumeration gate: boots `-device qemu-xhci` + `usb-kbd` and
    # asserts the device enumerates to Configured (XHCI_ENUM:configured) over
    # real control transfers, on top of the 78a bring-up.
    echo "pre-push: running cargo xtask xhci-enum-smoke..."
    cargo xtask xhci-enum-smoke --timeout 150
    # Phase 78c — full HID input gate: boots `-device qemu-xhci` + `usb-kbd`,
    # injects a real keystroke over QMP, and asserts it travels the whole USB
    # input chain (interrupt-IN Transfer event → usb-hid decode → kbd_server).
    # Set the env var additionally for branches touching userspace/drivers/usb-hid,
    # the kbd_server/mouse_server inject path, or kernel-core/src/usb/hid.
    echo "pre-push: running cargo xtask usb-smoke..."
    cargo xtask usb-smoke --timeout 160
fi

# Phase 79 — opt-in modern-NIC regression gate. `multi-nic-smoke` boots QEMU
# once per emulated NIC family (e1000 baseline + e1000e, and igb behind a
# QEMU >= 8.0 guard) and asserts each driver registers and reaches link
# (`E1000E_SMOKE:link:PASS`, etc.). Gated behind M3OS_MULTI_NIC_REGRESSION=1
# because it launches several QEMU instances; set it on branches touching the
# ring-3 NIC drivers, driver_runtime's net_ring/pci_enum, the device-host
# claim/IRQ syscalls, or the kernel RemoteNic registry.
if [ "${M3OS_MULTI_NIC_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask multi-nic-smoke..."
    cargo xtask multi-nic-smoke
fi

# Phase 80b — opt-in HDA audio regression gate. `hda-smoke` boots QEMU with
# `-device intel-hda -device hda-duplex`, brings up the ring-3 HDA driver
# (controller reset + CORB/RIRB RUN-enable + codec widget enumeration + output
# stream), runs `audio-demo` through `audio_server -> hda_driver`, and asserts a
# non-silent captured WAV. Gated behind M3OS_HDA_REGRESSION=1 because it boots a
# full QEMU + audio-demo run (~40s); set it on branches touching the hda/ac97
# drivers, `driver_ipc::audio`, the audio shm transport, `kernel_core::hda`, or
# the device-host audio-class IRQ routing.
if [ "${M3OS_HDA_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask hda-smoke..."
    if ! cargo xtask hda-smoke --timeout 240; then
        echo "pre-push: cargo xtask hda-smoke failed" >&2
        exit 1
    fi
fi

# Phase 81 — opt-in Wi-Fi regression gate. There is NO QEMU mt76 device model,
# so `wifi-smoke` is a skip-with-reason diagnostic (always exits 0); the radio
# path is validated on real hardware via VFIO passthrough
# (scripts/mt792x-vfio-validate.md). The real CI coverage is the
# kernel-core/wifi-core/crypto-lib/mt792x_driver host tests under
# `cargo xtask check`. Set M3OS_WIFI_REGRESSION=1 to surface the reminder; no
# exit-on-failure guard is needed because the gate cannot fail here.
if [ "${M3OS_WIFI_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask wifi-smoke..."
    cargo xtask wifi-smoke
fi

# Phase 82 — opt-in AHCI/SATA regression gate. `ahci-smoke` boots QEMU with
# `-device ich9-ahci` + a blank scratch `ide-hd`, brings up the ring-3 AHCI
# driver (HBA reset + port engine stop/start + COMRESET + IDENTIFY), and asserts
# the binding self-test sentinel set (IDENTIFY -> WRITE DMA EXT -> read-back
# byte-compare -> FLUSH CACHE EXT -> IDENTIFY-after-write -> server ready). The
# BOHC handoff / staggered spin-up / real completion interrupt are
# skip-with-reason on QEMU (validated via VFIO). Gated behind
# M3OS_AHCI_REGRESSION=1 because it boots a full QEMU run; set it on branches
# touching userspace/drivers/ahci, kernel_core::storage, the blk::remote
# cold-path lookup, or the init SATA-root bootstrap.
#
# `ahci-root-smoke` is the companion end-to-end gate: it routes the real ext2
# data disk to the AHCI controller (the `--device ahci` topology) and asserts
# the entire system boots with its root filesystem served over `ahci.block`
# (virtio root absent -> driver MBR/ext2 probe -> owner-gate accept -> `init: /
# mounted (ext2 via ring-3 ahci.block)` -> login prompt). It is the CI proof of
# the headline "a SATA disk mounts the root off ahci.block" that the isolated
# `ahci-smoke` self-test does not cover.
if [ "${M3OS_AHCI_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask ahci-smoke..."
    if ! cargo xtask ahci-smoke --timeout 240; then
        echo "pre-push: cargo xtask ahci-smoke failed" >&2
        exit 1
    fi
    echo "pre-push: running cargo xtask ahci-root-smoke..."
    if ! cargo xtask ahci-root-smoke --timeout 240; then
        echo "pre-push: cargo xtask ahci-root-smoke failed" >&2
        exit 1
    fi
fi

# Phase 85b — local git regression gate. Gated behind M3OS_GIT_REGRESSION=1
# because it cross-compiles git (+ zlib) — a multi-minute cold build — before
# booting QEMU and driving the `pkg install git` + local-repo workflow
# (init/add/commit/diff/log/branch/merge/status). Set it on branches that touch
# ports/util/git, xtask's build_git / git bundling, the `pkg` installer, or the
# kernel mmap / fork-exec / ext2 paths git exercises.
if [ "${M3OS_GIT_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask git-local-smoke..."
    # Phase 86c raised the timeout: git now depends on curl, so `pkg install git`
    # pulls the curl+mbedtls+ca-certificates chain (~27 MB) over the slow VFS. The
    # global is set above the 1800 s install-step ceiling so the boot/login + the
    # local-repo workflow (init/add/commit/diff/log/branch/merge/status) keep
    # headroom even if the install runs slow.
    if ! cargo xtask git-local-smoke --timeout 2400; then
        echo "pre-push: cargo xtask git-local-smoke failed" >&2
        exit 1
    fi
fi

# Phase 86b — git-over-SSH regression gate. Gated behind M3OS_GIT_SSH_REGRESSION=1
# because it cross-compiles the static dropbear `ssh` client before booting QEMU.
# The always-on core proves `pkg install ssh` + `pkg install git` (git reused
# unchanged), the dropbear client runs on m3OS, and GitHub's host key is seeded.
# The live `git clone ssh://git@github.com/...` and the host-key-mismatch reject
# are opt-in (M3OS_GIT_SSH_NET=1 for the mismatch test; M3OS_GIT_SSH_KEY=<path>
# for the clone) and skip-with-reason otherwise — so an unconfigured run still
# exercises the transport plumbing without needing GitHub egress/creds. The long
# (clang-class) timeout is a ceiling for the slow packfile transfer when the clone
# is enabled; the core path finishes well under it. Set it on branches that touch
# ports/util/dropbear, xtask's build_dropbear / ssh bundling / known_hosts
# seeding, or the GIT_SSH wiring.
if [ "${M3OS_GIT_SSH_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask git-ssh-smoke..."
    if ! cargo xtask git-ssh-smoke --timeout 5400; then
        echo "pre-push: cargo xtask git-ssh-smoke failed" >&2
        exit 1
    fi
fi

# Phase 86c — git-over-HTTPS regression gate. Gated behind M3OS_GIT_HTTPS_REGRESSION=1
# because it cross-compiles the HTTPS transport chain (mbedtls -> curl -> git,
# + ca-certificates) before booting QEMU. The always-on core proves `pkg install
# git` pulls + installs the whole curl+mbedtls+ca-certificates chain, the static
# curl+mbedTLS stack RUNS on m3OS (`curl --version` reports mbedTLS), and the
# gitconfig trust settings + CA bundle are wired. The live bad-cert REJECT
# (self-signed.badssl.com) and the public `git clone https://...` are opt-in
# (M3OS_GIT_HTTPS_NET=1, egress to :443, no secret) and skip-with-reason otherwise
# — so an unconfigured run still exercises the install + on-device-stack plumbing.
# The long (clang-class) timeout is a ceiling for the ~27 MB install over the slow
# VFS + the packfile transfer when the network arms run; the core finishes well
# under it. Set it on branches that touch ports/lib/mbedtls, ports/util/curl,
# xtask's build_mbedtls / build_curl / build_git / curl+mbedtls bundling, or the
# /etc/gitconfig HTTPS trust settings.
if [ "${M3OS_GIT_HTTPS_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask git-https-smoke..."
    if ! cargo xtask git-https-smoke --timeout 5400; then
        echo "pre-push: cargo xtask git-https-smoke failed" >&2
        exit 1
    fi
fi

# Phase 85c — Python regression gate. Gated behind M3OS_PYTHON_REGRESSION=1
# because it two-stage cross-compiles CPython (+ zlib + ncurses) — a
# several-minute cold build — before booting QEMU and driving `pkg install
# python` + REPL/import/script/file-IO assertions. The interpreter is fully
# static (MODULE_BUILDTYPE=static, -static, no lib-dynload, no dlopen), so set
# this on branches that touch ports/lang/python, xtask's build_python /
# freeze_stdlib_zip / curses (ncurses) wiring / python bundling, the `pkg`
# installer, or the kernel mmap / fork-exec / getrandom / ext2 paths the static
# interpreter exercises.
if [ "${M3OS_PYTHON_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask python-smoke..."
    if ! cargo xtask python-smoke --timeout 900; then
        echo "pre-push: cargo xtask python-smoke failed" >&2
        exit 1
    fi
fi

# Phase 85d — Clang/LLVM/LLD regression gate. Gated behind M3OS_CLANG_REGRESSION=1
# because it host-cross-builds clang + lld + a self-contained libc++ — a
# multi-GB-RAM, multi-hour cold build — before building an opt-in M3OS_WITH_CLANG
# image, booting QEMU, `pkg install clang`, and compiling + linking + running C/C++
# programs INSIDE m3OS. Set this on branches that touch ports/lang/llvm, xtask's
# build_llvm / clang bundling / clang-smoke, or the kernel mmap / exec / ext2 / VFS
# paths the big static toolchain exercises. Requires host clang + cmake + ninja.
if [ "${M3OS_CLANG_REGRESSION:-0}" = "1" ]; then
    echo "pre-push: running cargo xtask clang-smoke..."
    if ! cargo xtask clang-smoke --timeout 5400; then
        echo "pre-push: cargo xtask clang-smoke failed" >&2
        exit 1
    fi
fi
